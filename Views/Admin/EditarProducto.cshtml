@model MichiMarket.Models.Producto
@{
    ViewData["Title"] = "Editar Producto";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <a asp-controller="Admin" asp-action="Productos" class="btn btn-limpiar mb-4">
                    <i class="fas fa-arrow-left me-1"></i> Volver
                </a>

                <div class="card border-0 shadow-sm" style="border-radius: 12px;">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <i class="fas fa-edit" style="font-size: 2rem; color: var(--turquesa);"></i>
                            <h4 class="fw-bold mt-2">Editar Producto</h4>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger text-center py-2" style="font-size: 13px;">
                                <i class="fas fa-exclamation-circle me-1"></i> @ViewBag.Error
                            </div>
                        }

                        <form method="post" asp-controller="Admin" asp-action="EditarProducto" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id_producto" value="@Model.id_producto" />
                            <input type="hidden" name="foto_producto" value="@Model.foto_producto" />
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="text-center mb-3">
                                        <div class="img-preview-box" id="previewBox">
                                            <img id="imgPreview" src="~/@Model.foto_producto" alt="@Model.nombre" onerror="this.src='/img/gato_cara.png'" />
                                        </div>
                                    </div>
                                    <label class="form-label fw-bold">Cambiar foto</label>
                                    <input type="file" name="foto" id="inputFoto" class="form-control" accept="image/*" onchange="previewImage(event)" />
                                    <small class="text-muted">Deja vacio para mantener la foto actual.</small>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Nombre</label>
                                    <input type="text" name="nombre" class="form-control" value="@Model.nombre" required />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold">Descripcion</label>
                                    <input type="text" name="descripcion" class="form-control" value="@Model.descripcion" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Precio (S/)</label>
                                    <input type="number" name="precio" class="form-control" step="0.01" min="0" value="@Model.precio" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Stock</label>
                                    <input type="number" name="stock" class="form-control" min="0" value="@Model.stock" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tipo</label>
                                    <select name="tipo" class="form-select" required>
                                        <option value="alimento" selected="@(Model.tipo == "alimento")">Alimento</option>
                                        <option value="higiene" selected="@(Model.tipo == "higiene")">Higiene</option>
                                        <option value="salud" selected="@(Model.tipo == "salud")">Salud</option>
                                        <option value="accesorio" selected="@(Model.tipo == "accesorio")">Accesorios</option>
                                        <option value="juguetes" selected="@(Model.tipo == "juguetes")">Juguetes</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Animal</label>
                                    <select name="animal" class="form-select" required>
                                        <option value="gato" selected="@(Model.animal == "gato")">Gato</option>
                                        <option value="perro" selected="@(Model.animal == "perro")">Perro</option>
                                        <option value="cuy" selected="@(Model.animal == "cuy")">Cuy</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Estado</label>
                                    <select name="estadoStr" class="form-select">
                                        <option value="true" selected="@(Model.estado)">Activo</option>
                                        <option value="false" selected="@(!Model.estado)">Inactivo</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <button type="submit" class="btn btn-submit w-100">
                                        <i class="fas fa-save me-1"></i> Guardar Cambios
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
}
