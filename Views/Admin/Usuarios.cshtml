@model List<MichiMarket.Models.Usuario>
@{
    ViewData["Title"] = "Gestionar Usuarios";
    var adminId = Context.Session.GetInt32("id_usuario");
}

<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0"><i class="fas fa-users me-2"></i>Gestionar Usuarios</h4>
            <span class="text-muted">@Model.Count registros</span>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@u.id_usuario</td>
                                    <td>@u.nombres @u.apellidos</td>
                                    <td>@u.correo</td>
                                    <td>
                                        @if (u.rol == "admin")
                                        {
                                            <span class="admin-badge" style="background:#fef3c7;color:#d97706;">Admin</span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge" style="background:var(--turquesa-light);color:var(--turquesa-dark);">Cliente</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.estado)
                                        {
                                            <span class="admin-badge badge-activo">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge badge-inactivo">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (u.id_usuario != adminId)
                                        {
                                            <form method="post" asp-controller="Admin" asp-action="EliminarUsuario" class="d-inline delete-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.id_usuario" />
                                                <button type="submit" class="btn btn-sm btn-admin-delete" title="Eliminar">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
