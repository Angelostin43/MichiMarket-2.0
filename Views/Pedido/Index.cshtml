@model List<MichiMarket.Models.Pedido>
@{
    ViewData["Title"] = "Mis Pedidos";
}

<section class="py-5">
    <div class="container">
        <h4 class="fw-bold mb-4"><i class="fas fa-clipboard-list me-2"></i>Mis Pedidos</h4>

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-clipboard-list fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">No tienes pedidos aun</h5>
                <a asp-controller="Producto" asp-action="Index" class="btn btn-buscar mt-3">
                    <i class="fas fa-box-open me-1"></i> Ver Productos
                </a>
            </div>
        }
        else
        {
            @foreach (var pedido in Model.OrderByDescending(x => x.fecha_creacion))
            {
                var badgeClass = pedido.estado switch
                {
                    "pendiente" => "badge-pendiente",
                    "en_camino" => "badge-camino",
                    "entregado" => "badge-entregado",
                    _ => "badge-pendiente"
                };
                var estadoTexto = pedido.estado switch
                {
                    "pendiente" => "Pendiente",
                    "en_camino" => "En camino",
                    "entregado" => "Entregado",
                    _ => pedido.estado
                };

                <div class="pedido-card mb-3">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div>
                            <h6 class="fw-bold mb-1">Pedido #@pedido.id_pedido</h6>
                            <p class="text-muted small mb-0">
                                <i class="fas fa-calendar-alt me-1"></i> @pedido.fecha_creacion.ToString("dd/MM/yyyy hh:mm tt")
                            </p>
                        </div>
                        <div class="text-center">
                            <span class="badge @badgeClass">@estadoTexto</span>
                        </div>
                        <div class="text-end">
                            <p class="fw-bold mb-2" style="color: var(--turquesa-dark); font-size: 1.1rem;">S/ @pedido.total.ToString("F2")</p>
                            <a asp-controller="Pedido" asp-action="Detalle" asp-route-id="@pedido.id_pedido" class="btn btn-sm btn-buscar">
                                <i class="fas fa-eye me-1"></i> Ver detalle
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
